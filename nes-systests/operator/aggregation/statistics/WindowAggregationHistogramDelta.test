SELECT statisticStart, statisticEnd, binStart, binCounter, binEnd FROM (
    SELECT EQUIWIDTHHISTOGRAM_PROBE(83, uint64, uint64)
    FROM (
        SELECT EQUIWIDTHHISTOGRAM(83, value, 128, 0, 25) FROM streamUnaligned WINDOW TUMBLING(timestamp, size 1 sec)
    )
) INTO sinkProbeUnaligned;
