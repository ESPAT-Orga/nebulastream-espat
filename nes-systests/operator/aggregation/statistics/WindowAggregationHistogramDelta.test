# ==================================================================================================
# Unaligned: the stream's first window is NOT aligned to a keyframe index. Guards the property that a
# keyframe is always a window that ACTUALLY OCCURS, keyed by window ORDINAL rather than absolute index.
#
# N=5, 6 one-second windows at absolute indices 2..7 => ordinals 0..5, so keyframes at ordinals 0 (window
# 2000-3000) and 5 (window 7000-8000). Interval 0 therefore spans ordinals 0-4, i.e. BOTH data regimes: its
# keyframe counts into bin 0 while three of its deltas count into bin 2, so reconstruction must handle one
# bin dropping back to zero as another rises.
# ==================================================================================================
GlobalConfiguration worker.default_query_execution.histogram_delta_keyframe_interval: [5]

CREATE LOGICAL SOURCE streamUnaligned(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR streamUnaligned TYPE File;
# 6 windows (1 s each) starting at absolute window index 2. 5 bins of width 5 over [0,25). The windows starting
# 2000/3000/4000 put 1,2,3 tuples into bin 0 (value 0); those starting 5000/6000/7000 put 1,2,3 tuples into
# bin 2 (value 10). The first absolute index is 2, which is not a multiple of N=5.
ATTACH INLINE
1,0,2000
1,0,3000
1,0,3100
1,0,4000
1,0,4100
1,0,4200
1,10,5000
1,10,6000
1,10,6100
1,10,7000
1,10,7100
1,10,7200

CREATE SINK sinkProbeUnaligned(streamUnaligned.statisticStart UINT64 NOT NULL, streamUnaligned.statisticEnd UINT64 NOT NULL, streamUnaligned.binStart UINT64 NOT NULL, streamUnaligned.binCounter UINT64 NOT NULL, streamUnaligned.binEnd UINT64 NOT NULL) TYPE File;

# Build + probe the delta-compressed histogram under 4 threads.
SELECT statisticStart, statisticEnd, binStart, binCounter, binEnd FROM (
    SELECT EQUIWIDTHHISTOGRAM_PROBE(82, uint64, uint64)
    FROM (
        SELECT EQUIWIDTHHISTOGRAMDELTA(82, value, 128, 0, 25) FROM streamUnaligned WINDOW TUMBLING(timestamp, size 1 sec)
    )
) INTO sinkProbeUnaligned;
