# Delta-compressed equi-width histogram build (GEN/RESOLVER split). Same schema & sink as plain.yaml.template.
query: SELECT EQUIWIDTHHISTOGRAMDELTA({statistic_id}, value, {memory_budget}, {min_value}, {max_value}) FROM src WINDOW TUMBLING(timestamp, size {window_size} sec) INTO void_sink;
sinks:
  - name: void_sink
    host: localhost:8080
    schema:
      - name: src$statisticid
        type: UINT64
        nullable: false
      - name: src$statisticstart
        type: UINT64
        nullable: false
      - name: src$statisticend
        type: UINT64
        nullable: false
      - name: src$statisticnumberofseentuples
        type: UINT64
        nullable: false
    type: Void
    config: {{ }}
    parser_config: {{ }}
logical:
  - name: src
    schema:
      - name: value
        type: UINT64
        nullable: false
      - name: timestamp
        type: UINT64
        nullable: false
physical:
  - logical: src
    host: localhost:8080
    type: File
    parser_config:
      type: CSV
    source_config:
      file_path: {data_path}
workers:
  - host: localhost:8080
    data_address: localhost:9090
