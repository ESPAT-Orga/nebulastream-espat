#
# HIGH-priority generator → network sink benchmark query.
# Worker-2 hosts the GeneratorSource; worker-1 hosts the sink. The CLI inserts a NetworkSink/Source
# pair automatically because the placement sites differ.

priority: HIGH

query: |
  SELECT
    *
  FROM
    HIGH_GENERATOR_SOURCE
  INTO
    HIGH_VOID_SINK

sinks:
  - name: HIGH_VOID_SINK
    host: 127.0.0.1:18080
    schema:
      - name: HIGH_GENERATOR_SOURCE$VAL
        type: FLOAT64
    type: Void
    config: {}
    parser_config: {}

logical:
  - name: HIGH_GENERATOR_SOURCE
    schema:
      - name: VAL
        type: FLOAT64

physical:
  - logical: HIGH_GENERATOR_SOURCE
    host: 127.0.0.1:18081
    parser_config:
      type: CSV
      fieldDelimiter: ","
    type: Generator
    source_config:
      generator_rate_type: ${GENERATOR_RATE_TYPE}
      generator_rate_config: ${GENERATOR_RATE_CONFIG}
      stop_generator_when_sequence_finishes: NONE
      seed: 1
      generator_schema: |
        NORMAL_DISTRIBUTION FLOAT64 0 1

workers:
  - host: 127.0.0.1:18080
    data_address: 127.0.0.1:19090
    max_operators: 10000
  - host: 127.0.0.1:18081
    data_address: 127.0.0.1:19091
    downstream: [127.0.0.1:18080]
    max_operators: 10000
