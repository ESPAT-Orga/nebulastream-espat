# Skeleton for one statistic_overhead run. nes-cli accepts `query` as a list and submits each entry
# as its own query against the shared logical/physical/sink catalogs below, which is what makes the
# statistic queries read the *same* logical sources as the joins.
#
# Schemas mirror nes-systests/benchmark/Nexmark_with_varsized.test; the sink schemas follow the
# `<concatenated source names>$FIELD` convention (window bounds are uppercase START/END, see
# nes-frontend/apps/cli/tests/good/chained-joins.yaml).

query:
{queries_block}
sinks:
  - name: join_void_sink
    host: localhost:8080
    schema:
      - name: personauction$START
        type: UINT64
        nullable: false
      - name: personauction$END
        type: UINT64
        nullable: false
      - name: person$id
        type: INT32
        nullable: false
      - name: person$name
        type: VARSIZED
        nullable: false
    type: Void
    config: {{ }}
    parser_config: {{ }}
  - name: person_stat_sink
    host: localhost:8080
    schema:
      - name: person$statisticid
        type: UINT64
        nullable: false
      - name: person$statisticstart
        type: UINT64
        nullable: false
      - name: person$statisticend
        type: UINT64
        nullable: false
      - name: person$statisticnumberofseentuples
        type: UINT64
        nullable: false
    type: Void
    config: {{ }}
    parser_config: {{ }}
  - name: auction_stat_sink
    host: localhost:8080
    schema:
      - name: auction$statisticid
        type: UINT64
        nullable: false
      - name: auction$statisticstart
        type: UINT64
        nullable: false
      - name: auction$statisticend
        type: UINT64
        nullable: false
      - name: auction$statisticnumberofseentuples
        type: UINT64
        nullable: false
    type: Void
    config: {{ }}
    parser_config: {{ }}
logical:
  - name: person
    schema:
      - name: id
        type: INT32
        nullable: false
      - name: name
        type: VARSIZED
        nullable: false
      - name: email_address
        type: VARSIZED
        nullable: false
      - name: credit_card
        type: VARSIZED
        nullable: false
      - name: city
        type: VARSIZED
        nullable: false
      - name: state
        type: VARSIZED
        nullable: false
      - name: timestamp
        type: UINT64
        nullable: false
      - name: extra
        type: VARSIZED
        nullable: false
  - name: auction
    schema:
      - name: timestamp
        type: UINT64
        nullable: false
      - name: id
        type: INT32
        nullable: false
      - name: initialbid
        type: INT32
        nullable: false
      - name: reserve
        type: INT32
        nullable: false
      - name: expires
        type: UINT64
        nullable: false
      - name: seller
        type: INT32
        nullable: false
      - name: category
        type: INT32
        nullable: false
physical:
  - logical: person
    host: localhost:8080
    type: TCP
    parser_config:
      type: CSV
      fieldDelimiter: ","
    source_config:
      socket_host: 127.0.0.1
      socket_port: {person_port}
      flush_interval_ms: {flush_interval_ms}
      connect_timeout_seconds: 10
  - logical: auction
    host: localhost:8080
    type: TCP
    parser_config:
      type: CSV
      fieldDelimiter: ","
    source_config:
      socket_host: 127.0.0.1
      socket_port: {auction_port}
      flush_interval_ms: {flush_interval_ms}
      connect_timeout_seconds: 10
workers:
  - host: localhost:8080
    data_address: localhost:9090
    max_operators: {max_operators}
