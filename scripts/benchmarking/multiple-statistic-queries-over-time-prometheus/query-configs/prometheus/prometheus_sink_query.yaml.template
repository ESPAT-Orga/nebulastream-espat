query: SELECT value FROM {source_name} INTO prometheus_sink;
sinks:
  - name: prometheus_sink
    host: localhost:8080
    schema:
      - name: {source_name}$value
        type: UINT64
    type: Prometheus
    config:
      output_format: NATIVE
      server_url: {sink_host}:{sink_port}
      file_path: "/tmp/discard_sink.csv"
      histogram_num_buckets: {num_buckets}
      histogram_min_value: {min_value}
      histogram_max_value: {max_value}
    parser_config: {{ }}
logical:
  - name: {source_name}
    schema:
      - name: id
        type: UINT64
      - name: value
        type: UINT64
      - name: timestamp
        type: UINT64
physical:
  - logical: {source_name}
    host: localhost:8080
    type: TCP
    parser_config:
      type: CSV
    source_config:
      socket_host: 127.0.0.1
      socket_port: {tcp_port}
      flush_interval_ms: {flush_interval}
      connect_timeout_seconds: 10
workers:
  - host: localhost:8080
    data_address: localhost:9090
    max_operators: 10000
